---
import '../styles/global.css';

const raceFacts = [
  { value: '6,706', unit: 'km', label: 'par boucle' },
  { value: '240', unit: 'm D+', label: 'par boucle' },
  { value: '60', unit: 'min', label: 'pour finir' },
  { value: '1', unit: 'seul', label: 'à l’arrivée' }
];

const loopSteps = [
  { number: '01', title: 'Le signal', text: 'À chaque heure pile, tous les coureurs repartent ensemble depuis le corral.' },
  { number: '02', title: 'La boucle', text: '6,706 km et 240 m D+ à parcourir intégralement en moins de soixante minutes.' },
  { number: '03', title: 'Le répit', text: 'Chaque minute gagnée sur la boucle devient du temps pour souffler, manger et repartir.' },
  { number: '04', title: 'Le dernier', text: 'Manquer le départ élimine. La course continue jusqu’à ce qu’il n’en reste plus qu’un.' }
];

const rules = [
  { title: 'Le parcours', text: 'Le parcours fait exactement 6 706 mètres (4,167 miles) avec 240 mètres de dénivelé positif par tour. Le tracé sera communiqué avant l’épreuve.' },
  { title: 'Le départ', text: 'Chaque tour commence exactement une heure après le précédent. Trois signaux sonores sont donnés : 3 minutes, 2 minutes et 1 minute avant le départ. Tous les coureurs doivent être présents dans le corral au coup de sifflet.' },
  { title: 'Délais et validation', text: 'Le coureur doit effectuer le tour complet en moins d’une heure. S’il n’est pas dans le corral au départ du tour suivant, il est éliminé (DNF).' },
  { title: 'Assistance et équipement', text: 'L’assistance personnelle est uniquement autorisée dans la zone de ravitaillement entre les boucles. Aucune aide extérieure ni aucun pacer ne sont autorisés pendant la boucle.' },
  { title: 'Le vainqueur', text: 'La course s’arrête lorsqu’il ne reste plus qu’un seul coureur capable d’accomplir seul une boucle complète. Si aucun coureur ne réussit le dernier tour, il n’y a aucun vainqueur.' },
  { title: 'Esprit et sécurité', text: 'Matériel obligatoire : lampe frontale et réserve d’eau minimale. La convivialité et le respect de la nature du Haut-Doubs sont obligatoires.' }
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Backyard du Haut-Doubs à Gilley : une boucle de 6,706 km et 240 m D+ toutes les heures, jusqu’au dernier coureur debout." />
    <meta name="theme-color" content="#123d37" />
    <meta property="og:title" content="Backyard du Haut-Doubs" />
    <meta property="og:description" content="Une boucle. Une heure. Jusqu’au dernier. Rendez-vous le 18 septembre 2027 à Gilley." />
    <meta property="og:image" content="/images/parcours-haut-doubs.jpg" />
    <title>Backyard du Haut-Doubs — Gilley</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <div class="intro-screen" aria-hidden="true">
      <div class="intro-mark">
        <div class="intro-logo">
          <img src="/images/logo-backyard-transparent.png" alt="" width="412" height="270" />
          <svg class="intro-mountain-route" viewBox="0 0 412 270" role="presentation" preserveAspectRatio="xMidYMid meet">
            <path class="route-glow" pathLength="1" d="M38 193 L139 128 L165 146 L205 99 C220 113 228 126 241 133 L285 159 L311 142 L382 187"></path>
            <path class="route-stroke" pathLength="1" d="M38 193 L139 128 L165 146 L205 99 C220 113 228 126 241 133 L285 159 L311 142 L382 187"></path>
          </svg>
        </div>
        <p><span>Gilley</span><b>La boucle commence ici</b><span>2027</span></p>
      </div>
    </div>

    <header class="site-header">
      <a class="brand" href="#accueil" aria-label="Backyard du Haut-Doubs — accueil">
        <img src="/images/logo-backyard-blanc.png" alt="" width="412" height="270" />
      </a>
      <nav aria-label="Navigation principale">
        <a href="#concept">Le concept</a>
        <a href="#format">Le format</a>
        <a href="#infos">Infos</a>
      </nav>
      <button class="header-cta" type="button" data-open-registration>
        S’inscrire
        <span aria-hidden="true">↗</span>
      </button>
    </header>

    <main id="contenu">
      <section class="hero" id="accueil" aria-labelledby="hero-title">
        <img class="hero-media" src="/images/parcours-haut-doubs.jpg" alt="Clairière et lisière de forêt sur le parcours à Gilley" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-grid container">
          <div class="hero-copy">
            <p class="eyebrow eyebrow-light"><span></span> 1ère édition · Gilley · 18.09.2027</p>
            <h1 id="hero-title" class="hero-logo-title">
              <img src="/images/logo-backyard-transparent.png" alt="Backyard du Haut-Doubs" width="412" height="270" />
            </h1>
            <div class="hero-countdown">
              <div class="hero-countdown-heading">
                <span>Départ dans</span>
                <small>18 septembre 2027 · 09:00</small>
              </div>
              <div class="countdown" aria-label="Compte à rebours avant le départ" aria-live="polite">
                <div><strong id="days" data-countdown="days">000</strong><span>jours</span></div>
                <div><strong id="hours" data-countdown="hours">00</strong><span>heures</span></div>
                <div><strong id="minutes" data-countdown="minutes">00</strong><span>minutes</span></div>
                <div><strong id="seconds" data-countdown="seconds">00</strong><span>secondes</span></div>
              </div>
            </div>
            <p class="hero-lead">Une boucle. Une heure.<br />Jusqu’au dernier.</p>
            <div class="hero-actions">
              <button class="button button-accent" type="button" data-open-registration>
                Prendre le départ <span aria-hidden="true">↗</span>
              </button>
              <button class="button button-ghost" type="button" data-open-rules>
                Voir le règlement
              </button>
              <button class="button button-live" type="button" data-open-live>
                <span class="live-dot" aria-hidden="true"></span>
                Suivre la course en direct
              </button>
            </div>
          </div>
          <div class="hero-side">
            <p>Première édition</p>
            <strong>18</strong>
            <p>Sept. 2027<br />Départ 09:00</p>
          </div>
        </div>
        <a class="scroll-cue" href="#concept">
          <span>Découvrir</span>
          <span aria-hidden="true">↓</span>
        </a>
      </section>

      <section class="facts" aria-label="Chiffres clés de la course">
        <div class="facts-grid container">
          {raceFacts.map((fact) => (
            <article class="fact">
              <div><strong>{fact.value}</strong><span>{fact.unit}</span></div>
              <p>{fact.label}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section concept" id="concept">
        <div class="container concept-heading">
          <div>
            <p class="eyebrow"><span></span> Le principe</p>
            <h2>Simple à comprendre.<br /><em>Impossible à prévoir.</em></h2>
          </div>
          <p class="section-intro">Inventée par Lazarus Lake, créateur de la mythique Barkley, la Backyard Ultra transforme une règle élémentaire en défi physique et mental hors norme.</p>
        </div>

        <div class="loop-line container">
          {loopSteps.map((step) => (
            <article class="loop-step">
              <span class="step-number">{step.number}</span>
              <div class="step-marker"></div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>

        <div class="manifesto container">
          <p>Pas de ligne d’arrivée.</p>
          <p>Pas de distance annoncée.</p>
          <strong>Seulement la prochaine boucle.</strong>
        </div>
      </section>

      <section class="poster-story" aria-labelledby="poster-title">
        <div class="container poster-layout">
          <div class="poster-frame">
            <img src="/images/affiche-officielle.jpg" alt="Affiche officielle de la première Backyard du Haut-Doubs" loading="lazy" />
            <span>Affiche officielle · 2027</span>
          </div>
          <div class="poster-copy">
            <p class="eyebrow"><span></span> Première édition</p>
            <h2 id="poster-title">L’esprit du Haut-Doubs,<br /><em>boucle après boucle.</em></h2>
            <p>Des sapins, des pâturages, un sentier qui ne finit jamais et une énergie bien comtoise. L’affiche officielle pose le décor : une course exigeante, mais surtout une aventure vivante et collective.</p>
            <div class="poster-details">
              <div><span>Départ & arrivée</span><strong>Gymnase de Gilley</strong></div>
              <div><span>La boucle</span><strong>6,7 km · 240 D+</strong></div>
            </div>
          </div>
        </div>
      </section>

      <section class="format" id="format">
        <div class="format-texture"></div>
        <div class="container format-layout">
          <div class="format-copy">
            <p class="eyebrow eyebrow-light"><span></span> Le défi ultime</p>
            <h2>Combien de fois<br />répondrez-vous<br /><em>à l’appel ?</em></h2>
            <p>En 24 tours, vous franchissez la barre des 100 miles et cumulez 5 760 mètres de dénivelé positif. Votre seule distance cible est celle que vous êtes prêt à défendre.</p>
          </div>

          <div class="race-tools">
            <div class="calculator-card">
              <div>
                <p class="tool-label">Votre objectif</p>
                <h3>Simulez votre course</h3>
              </div>
              <label for="toursInput">Nombre de tours</label>
              <div class="range-row">
                <input id="toursInput" type="range" min="1" max="100" value="12" />
                <output id="resTours" for="toursInput">12</output>
              </div>
              <div class="results">
                <div><strong id="resKm">80,47</strong><span>kilomètres</span></div>
                <div><strong id="resDenivele">2 760</strong><span>mètres D+</span></div>
                <div><strong id="resHours">12</strong><span>heures</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section practical" id="infos">
        <div class="container">
          <div class="practical-heading">
            <div>
              <p class="eyebrow"><span></span> Sur place</p>
              <h2>Rendez-vous<br /><em>à Gilley.</em></h2>
            </div>
            <p>Au cœur du Haut-Doubs, dans un décor de pâturages et de forêts où chaque boucle racontera une histoire différente.</p>
          </div>

          <div class="practical-grid">
            <article class="info-card info-card-dark">
              <span class="info-icon" aria-hidden="true">◎</span>
              <p>Règlement officiel</p>
              <h3>Tout savoir avant de partir</h3>
              <button type="button" data-open-rules>Consulter les 6 règles <span aria-hidden="true">→</span></button>
            </article>
          </div>

          <div class="map-card">
            <div class="map-frame">
              <iframe
                title="Carte Google Maps du Gymnase de Gilley"
                src="https://www.google.com/maps?q=47.05345%2C6.49163&z=16&output=embed"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
            <div class="map-details">
              <p>Départ & arrivée</p>
              <h3>Gymnase<br />de Gilley</h3>
              <address>Rue de la Gare<br />25650 Gilley</address>
              <a href="https://www.google.com/maps/dir/?api=1&destination=47.05345%2C6.49163" target="_blank" rel="noreferrer">
                Ouvrir l’itinéraire <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="partners" aria-labelledby="partners-title">
        <div class="container partners-layout">
          <div>
            <p class="eyebrow"><span></span> À nos côtés</p>
            <h2 id="partners-title">Nos partenaires</h2>
            <p>Ils rendent l’aventure possible et font vivre le territoire.</p>
          </div>
          <div class="partners-grid">
            <div class="partner partner-logo"><img src="/images/partenaire-gaby.jpg" alt="Le Tuyé du Papy Gaby" loading="lazy" /></div>
            <div class="partner partner-logo"><img src="/images/partenaire-gilley.jpg" alt="Commune de Gilley" loading="lazy" /></div>
            <div class="partner partner-logo partner-community">
              <img src="/images/ccEntreDoubsEtLouee.png" alt="Communauté de communes Entre Doubs et Loue" loading="lazy" />
            </div>
            <div class="partner partner-name">Partenaire<br />local</div>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="container final-cta-layout">
          <div>
            <p class="eyebrow eyebrow-light"><span></span> L’aventure se construit ensemble</p>
            <h2>Vivez la course<br /><em>de l’intérieur.</em></h2>
          </div>
          <a class="round-link" href="mailto:backyardhautdoubs@gmail.com?subject=Devenir%20b%C3%A9n%C3%A9vole%20%E2%80%94%20Backyard%20du%20Haut-Doubs">
            <span>Devenir<br />bénévole</span>
            <b aria-hidden="true">↗</b>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-grid">
        <a class="footer-brand" href="#accueil">
          <img src="/images/logo-backyard-blanc.png" alt="Backyard du Haut-Doubs" width="412" height="270" loading="lazy" />
        </a>
        <p>Une boucle de 6,706 km.<br />Chaque heure. Jusqu’au dernier.</p>
        <div>
          <a href="mailto:backyardhautdoubs@gmail.com">Nous contacter</a>
          <button type="button" data-open-rules>Règlement</button>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2027 Backyard du Haut-Doubs</span>
        <span>Gilley · France</span>
      </div>
    </footer>

    <dialog class="rules-dialog live-dialog" id="liveDialog" aria-labelledby="live-title">
      <div class="live-dialog-inner">
        <button class="dialog-close" type="button" data-close-live aria-label="Fermer la fenêtre de suivi">×</button>
        <p class="live-kicker"><span></span><b id="waitKicker">Suivi de la course</b></p>
        <h2 id="live-title">Encore un peu<br />de patience.</h2>
        <p class="live-message" id="waitMessage">La vue en direct de la course sera disponible dans :</p>
        <div class="countdown live-countdown" aria-label="Temps restant avant l’ouverture du suivi en direct" aria-live="polite">
          <div><strong data-countdown="days">000</strong><span>jours</span></div>
          <div><strong data-countdown="hours">00</strong><span>heures</span></div>
          <div><strong data-countdown="minutes">00</strong><span>minutes</span></div>
          <div><strong data-countdown="seconds">00</strong><span>secondes</span></div>
        </div>
        <button class="button button-accent live-dialog-action" type="button" data-close-live>Retour au site</button>
      </div>
    </dialog>

    <dialog class="rules-dialog" id="rulesDialog" aria-labelledby="rules-title">
      <div class="dialog-top">
        <div>
          <p class="eyebrow"><span></span> Avant de partir</p>
          <h2 id="rules-title">Règlement officiel</h2>
          <p>Backyard du Haut-Doubs · 18 septembre 2027</p>
        </div>
        <button class="dialog-close" type="button" data-close-rules aria-label="Fermer le règlement">×</button>
      </div>
      <div class="rules-list">
        {rules.map((rule, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{rule.title}</h3><p>{rule.text}</p></div>
          </article>
        ))}
      </div>
      <button class="button button-dark dialog-action" type="button" data-close-rules>J’ai compris</button>
    </dialog>

    <script>
      const targetDate = new Date('2027-09-18T09:00:00+02:00').getTime();
      const countdownElements = {
        days: document.querySelectorAll<HTMLElement>('[data-countdown="days"]'),
        hours: document.querySelectorAll<HTMLElement>('[data-countdown="hours"]'),
        minutes: document.querySelectorAll<HTMLElement>('[data-countdown="minutes"]'),
        seconds: document.querySelectorAll<HTMLElement>('[data-countdown="seconds"]')
      };

      function updateCountdown() {
        const remaining = Math.max(0, targetDate - Date.now());
        const days = Math.floor(remaining / 86_400_000);
        const hours = Math.floor((remaining % 86_400_000) / 3_600_000);
        const minutes = Math.floor((remaining % 3_600_000) / 60_000);
        const seconds = Math.floor((remaining % 60_000) / 1_000);

        countdownElements.days.forEach((element) => element.textContent = String(days).padStart(3, '0'));
        countdownElements.hours.forEach((element) => element.textContent = String(hours).padStart(2, '0'));
        countdownElements.minutes.forEach((element) => element.textContent = String(minutes).padStart(2, '0'));
        countdownElements.seconds.forEach((element) => element.textContent = String(seconds).padStart(2, '0'));
      }

      updateCountdown();
      window.setInterval(updateCountdown, 1000);

      const toursInput = document.querySelector<HTMLInputElement>('#toursInput');
      const resTours = document.querySelector<HTMLOutputElement>('#resTours');
      const resKm = document.querySelector('#resKm');
      const resDenivele = document.querySelector('#resDenivele');
      const resHours = document.querySelector('#resHours');
      const numberFormat = new Intl.NumberFormat('fr-FR');
      const decimalFormat = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      function updateCalculator() {
        const tours = Number(toursInput?.value ?? 0);
        if (resTours) resTours.textContent = String(tours);
        if (resKm) resKm.textContent = decimalFormat.format(tours * 6.706);
        if (resDenivele) resDenivele.textContent = numberFormat.format(tours * 240);
        if (resHours) resHours.textContent = String(tours);
      }

      toursInput?.addEventListener('input', updateCalculator);
      updateCalculator();

      const dialog = document.querySelector<HTMLDialogElement>('#rulesDialog');
      document.querySelectorAll<HTMLElement>('[data-open-rules]').forEach((button) => {
        button.addEventListener('click', () => dialog?.showModal());
      });
      document.querySelectorAll<HTMLElement>('[data-close-rules]').forEach((button) => {
        button.addEventListener('click', () => dialog?.close());
      });
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      const liveDialog = document.querySelector<HTMLDialogElement>('#liveDialog');
      const waitKicker = document.querySelector('#waitKicker');
      const waitMessage = document.querySelector('#waitMessage');
      document.querySelectorAll<HTMLElement>('[data-open-live]').forEach((button) => {
        button.addEventListener('click', () => {
          if (waitKicker) waitKicker.textContent = 'Suivi de la course';
          if (waitMessage) waitMessage.textContent = 'La vue en direct de la course sera disponible dans :';
          liveDialog?.showModal();
        });
      });
      document.querySelectorAll<HTMLElement>('[data-open-registration]').forEach((button) => {
        button.addEventListener('click', () => {
          if (waitKicker) waitKicker.textContent = 'Inscriptions';
          if (waitMessage) waitMessage.textContent = 'Le site d’inscription sera disponible dans :';
          liveDialog?.showModal();
        });
      });
      document.querySelectorAll<HTMLElement>('[data-close-live]').forEach((button) => {
        button.addEventListener('click', () => liveDialog?.close());
      });
      liveDialog?.addEventListener('click', (event) => {
        if (event.target === liveDialog) liveDialog.close();
      });
    </script>
  </body>
</html>
