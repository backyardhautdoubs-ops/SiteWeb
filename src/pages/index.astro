---
import '../styles/global.css';

// Keep the draft rules out of the public page until they are ready.
const rulesAvailable = false;

const raceFacts = [
  { value: '6,706', unit: 'km', label: 'par boucle' },
  { value: '240', unit: 'm D+', label: 'par boucle' },
  { value: '60', unit: 'min', label: 'pour finir' },
  { value: '1', unit: 'seul', label: 'à l’arrivée' }
];

const loopSteps = [
  { number: '01', title: 'Le signal', text: 'À chaque heure pile, tous les coureurs repartent ensemble depuis le sas de départ.' },
  { number: '02', title: 'La boucle', text: '6,706 km et 240 m D+ à parcourir intégralement en moins de soixante minutes.' },
  { number: '03', title: 'Le répit', text: 'Chaque minute gagnée sur la boucle devient du temps pour souffler, manger et repartir.' },
  { number: '04', title: 'Le dernier', text: 'Manquer le départ élimine. La course continue jusqu’à ce qu’il n’en reste plus qu’un.' }
];

const rules = [
  { title: 'Le parcours', text: 'Le parcours fait exactement 6 706 mètres (4,167 miles) avec 240 mètres de dénivelé positif par tour. Le tracé sera communiqué avant l’épreuve.' },
  { title: 'Le départ', text: 'Chaque tour commence exactement une heure après le précédent. Trois signaux sonores sont donnés : 3 minutes, 2 minutes et 1 minute avant le départ. Tous les coureurs doivent être présents dans le sas de départ au coup de sifflet.' },
  { title: 'Délais et validation', text: 'Le coureur doit effectuer le tour complet en moins d’une heure. S’il n’est pas dans le sas de départ au départ du tour suivant, il est éliminé (DNF).' },
  { title: 'Assistance et équipement', text: 'L’assistance personnelle est uniquement autorisée dans la zone de ravitaillement entre les boucles. Aucune aide extérieure ni aucun pacer ne sont autorisés pendant la boucle.' },
  { title: 'Le vainqueur', text: 'La course s’arrête lorsqu’il ne reste plus qu’un seul coureur capable d’accomplir seul une dernière boucle complète en moins d’une heure. Si aucun coureur ne réussit le dernier tour, il n’y a aucun vainqueur.' },
  { title: 'Esprit et sécurité', text: 'Matériel obligatoire : lampe frontale et réserve d’eau minimale. La convivialité et le respect de la nature du Haut-Doubs sont obligatoires.' }
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Backyard du Haut-Doubs à Gilley : une boucle de 6,706 km et 240 m D+ toutes les heures, jusqu’au dernier coureur debout." />
    <meta name="theme-color" content="#123d37" />
    <meta property="og:title" content="Backyard du Haut-Doubs" />
    <meta property="og:description" content="Une boucle. Une heure. Jusqu’au dernier. Rendez-vous le 18 septembre 2027 à Gilley." />
    <meta property="og:image" content="/images/parcours-haut-doubs.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('backyard-intro-seen') && !location.hash) {
          document.documentElement.dataset.intro = 'play';
          sessionStorage.setItem('backyard-intro-seen', '1');
        }
      } catch { /* The page remains immediately available if storage is disabled. */ }
    </script>
    <title>Backyard du Haut-Doubs — Gilley</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <div class="intro-screen">
      <div class="intro-mark" aria-hidden="true">
        <div class="intro-orbit">
          <svg viewBox="0 0 320 320" class="intro-loop">
            <circle class="intro-loop-track" cx="160" cy="160" r="148" />
            <circle class="intro-loop-progress" cx="160" cy="160" r="148" pathLength="1" />
          </svg>
          <img src="/images/logo-backyard-transparent.png" alt="" width="412" height="270" />
          <span class="intro-lap">01 / ∞</span>
        </div>
        <p>Une boucle. <b>Tout commence.</b></p>
        <span class="intro-location">Gilley · Haut-Doubs · 2027</span>
      </div>
      <button type="button" class="intro-skip" data-skip-intro>Passer l’intro <span aria-hidden="true">↗</span></button>
    </div>

    <header class="site-header">
      <a class="brand" href="#accueil" aria-label="Backyard du Haut-Doubs — accueil">
        <img src="/images/logo-backyard-transparent.png" alt="" width="412" height="270" />
        <span>Haut-Doubs<b>Gilley, France</b></span>
      </a>
      <nav id="primary-navigation" aria-label="Navigation principale">
        <a href="#concept">Le concept</a>
        <a href="#format">Votre défi</a>
        <a href="#infos">Infos pratiques</a>
        <a href="#questions">FAQ</a>
        <a href="#sponsors">Sponsors</a>
      </nav>
      <a class="header-cta" href="https://inscription.pointcourse.com/epreuve/backyard-du-haut-doubs" target="_blank" rel="noreferrer">
        S’inscrire <span aria-hidden="true">↗</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Ouvrir le menu"><span></span><span></span></button>
    </header>

    <main id="contenu">
      <section class="hero" id="accueil" aria-labelledby="hero-title">
        <img class="hero-media" src="/images/parcours-1600.webp" srcset="/images/parcours-640.webp 640w, /images/parcours-1024.webp 1024w, /images/parcours-1600.webp 1600w" sizes="100vw" alt="Clairière et lisière de forêt sur le parcours à Gilley" width="1600" height="900" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-topline container" aria-hidden="true"><span>Le Haut-Doubs, sans ligne d’arrivée.</span><span>47°03′ N · 6°29′ E</span></div>
        <div class="hero-grid container">
          <div class="hero-copy">
            <p class="eyebrow eyebrow-light"><span></span> Backyard Ultra · Première édition</p>
            <p class="hero-event-date"><time datetime="2027-09-18T06:00:00+02:00">18 septembre 2027</time><span>Gilley · 06:00</span></p>
            <h1 id="hero-title" class="hero-logo-title">
              <img src="/images/logo-backyard-transparent.png" alt="Backyard du Haut-Doubs" width="412" height="270" />
            </h1>
            <p class="hero-lead">Une boucle. Une heure.<br /><em>Jusqu’au dernier.</em></p>
            <p class="hero-description">Les sapins pour décor. Le mental pour moteur.<br />Et toujours, une nouvelle raison de repartir.</p>
            <div class="hero-actions">
              <a class="button button-accent" href="https://inscription.pointcourse.com/epreuve/backyard-du-haut-doubs" target="_blank" rel="noreferrer">
                Prendre le départ <span aria-hidden="true">↗</span>
              </a>
              <a class="button button-ghost" href="#concept">Découvrir le concept <span aria-hidden="true">↓</span></a>
            </div>
            <p class="hero-registration-note">Ouverture des inscriptions le 6 décembre · Consultez PointCourse.</p>
          </div>
          <aside class="race-pass" aria-label="Votre rendez-vous à Gilley">
            <div class="pass-top"><span>Votre prochain départ</span><span class="edition-tag">Édition 01</span></div>
            <div class="pass-date"><strong>18<span>.09</span></strong><span>2027</span></div>
            <div class="pass-place"><span>Gilley, Haut-Doubs</span><span>Samedi · 06:00</span></div>
            <div class="hero-countdown">
              <p id="countdown-heading">Le premier départ approche</p>
              <div class="countdown" role="timer" aria-label="Compte à rebours avant le départ" aria-live="off">
                <div><strong id="days" data-countdown="days">—</strong><span>jours</span></div>
                <div><strong id="hours" data-countdown="hours">—</strong><span>heures</span></div>
                <div><strong id="minutes" data-countdown="minutes">—</strong><span>min</span></div>
                <div><strong id="seconds" data-countdown="seconds">—</strong><span>sec</span></div>
              </div>
            </div>
            <button class="pass-live" type="button" data-open-live><span class="status-dot" aria-hidden="true"></span> Le suivi de course <span aria-hidden="true">↗</span></button>
          </aside>
        </div>
        <a class="scroll-cue" href="#concept">
          <span>Découvrir</span>
          <span aria-hidden="true">↓</span>
        </a>
      </section>

      <section class="facts" aria-label="Chiffres clés de la course">
        <div class="facts-grid container">
          {raceFacts.map((fact) => (
            <article class="fact">
              <div><strong>{fact.value}</strong><span>{fact.unit}</span></div>
              <p>{fact.label}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section concept" id="concept">
        <div class="container concept-heading">
          <div>
            <p class="eyebrow"><span></span> Le principe</p>
            <h2>Simple à comprendre.<br /><em>Impossible à prévoir.</em></h2>
          </div>
          <p class="section-intro">Inventée par Lazarus Lake, créateur de la mythique Barkley, la Backyard Ultra transforme une règle élémentaire en défi physique et mental hors norme.</p>
        </div>

        <div class="loop-line container">
          {loopSteps.map((step) => (
            <article class="loop-step">
              <span class="step-number">{step.number}</span>
              <div class="step-marker"></div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>

        <div class="manifesto container">
          <span class="manifesto-symbol" aria-hidden="true">∞</span>
          <p>Pas de ligne d’arrivée.</p>
          <p>Pas de distance annoncée.</p>
          <strong>Seulement la prochaine boucle.</strong>
        </div>
      </section>

      <section class="poster-story" aria-labelledby="poster-title">
        <div class="container poster-layout">
          <div class="poster-frame">
            <img src="/images/affiche-officielle.webp" alt="Affiche officielle de la première Backyard du Haut-Doubs" width="720" height="1000" loading="lazy" />
            <span>Affiche officielle · 2027</span>
          </div>
          <div class="poster-copy">
            <p class="eyebrow"><span></span> Première édition</p>
            <h2 id="poster-title">L’esprit du Haut-Doubs,<br /><em>boucle après boucle.</em></h2>
            <p>Des sapins, des pâturages, un sentier qui ne finit jamais et une énergie bien comtoise. L’affiche officielle pose le décor : une course exigeante, mais surtout une aventure vivante et collective.</p>
            <div class="poster-details">
              <div><span>Départ & arrivée</span><strong>Gymnase de Gilley</strong></div>
              <div><span>La boucle</span><strong>6,7 km · 240 D+</strong></div>
            </div>
          </div>
        </div>
      </section>

      <section class="format" id="format">
        <div class="format-texture"></div>
        <div class="container format-layout">
          <div class="format-copy">
            <p class="eyebrow eyebrow-light"><span></span> Le défi ultime</p>
            <h2>Combien de fois<br />répondrez-vous<br /><em>à l’appel ?</em></h2>
            <p>En 24 tours, vous franchissez la barre des 100 miles et cumulez 5 760 mètres de dénivelé positif. Votre seule distance cible est celle que vous êtes prêt à défendre.</p>
          </div>

          <div class="race-tools">
            <div class="calculator-card">
              <div class="calculator-heading">
                <span class="calculator-symbol" aria-hidden="true">↻</span>
                <div>
                <p class="tool-label">Votre objectif</p>
                <h3>Simulez votre course</h3>
                </div>
              </div>
              <p class="calculator-intro">Une boucle à la fois. Jusqu’où vous emmènera la prochaine ?</p>
              <label for="toursInput">Nombre de tours</label>
              <div class="range-row">
                <input id="toursInput" type="range" min="1" max="100" value="12" />
                <output id="resTours" for="toursInput">12</output>
              </div>
              <div class="results">
                <div><strong id="resKm">80,47</strong><span>kilomètres</span></div>
                <div><strong id="resDenivele">2 880</strong><span>mètres D+</span></div>
                <div><strong id="resHours">12</strong><span>heures</span></div>
              </div>
              <div class="lap-presets" aria-label="Objectifs de course"><button type="button" data-laps="6" aria-pressed="false">6 tours</button><button type="button" data-laps="12" aria-pressed="true">12 tours</button><button type="button" data-laps="24" aria-pressed="false">24 tours · 100 miles</button></div>
              <p class="calculator-note">240 m de dénivelé à chaque tour. Le défi du Haut-Doubs.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section practical" id="infos">
        <div class="container">
          <div class="practical-heading">
            <div>
              <p class="eyebrow"><span></span> Sur place</p>
              <h2>Rendez-vous<br /><em>à Gilley.</em></h2>
            </div>
            <p>Au cœur du Haut-Doubs, dans un décor de pâturages et de forêts où chaque boucle racontera une histoire différente.</p>
          </div>

          <div class="practical-grid">
            <article class="info-card">
              <span class="info-icon" aria-hidden="true">↗</span><p>Le rendez-vous</p><h3>18 septembre 2027</h3><p>Premier départ à 06:00.<br />Puis à chaque heure pile.</p>
              <a href="/backyard-haut-doubs.ics" download>Ajouter à mon agenda <span aria-hidden="true">+</span></a>
            </article>
            <article class="info-card">
              <span class="info-icon" aria-hidden="true">↻</span><p>Le terrain de jeu</p><h3>6,706 km · 240 m D+</h3><p>Sentiers, pâturages et forêts.<br />Le tracé sera communiqué avant l’épreuve.</p>
              <a href="#format">Préparer mon objectif <span aria-hidden="true">→</span></a>
            </article>
            <article class="info-card info-card-dark">
              <span class="info-icon" aria-hidden="true">◎</span>
              <p>Règlement officiel</p>
              <h3>Tout savoir avant de partir</h3>
              <button type="button" disabled={!rulesAvailable} data-open-rules={rulesAvailable ? '' : undefined}>{rulesAvailable ? 'Consulter le règlement' : 'Prochainement disponible'} <span aria-hidden="true">{rulesAvailable ? '→' : '…'}</span></button>
            </article>
          </div>

          <div class="map-card">
            <div class="map-frame">
              <iframe
                title="Carte Google Maps du Gymnase de Gilley"
                src="https://www.google.com/maps?q=47.05345%2C6.49163&z=16&output=embed"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
            <div class="map-details">
              <p>Départ & arrivée</p>
              <h3>Gymnase<br /> de Gilley</h3>
              <address>Rue de la Gare<br />25650 Gilley</address>
              <a href="https://www.google.com/maps/dir/?api=1&destination=47.05345%2C6.49163" target="_blank" rel="noreferrer">
                Ouvrir l’itinéraire <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="section faq" id="questions" aria-labelledby="faq-title">
        <div class="container faq-layout">
          <div><p class="eyebrow"><span></span> Avant le premier tour</p><h2 id="faq-title">Le départ,<br /><em>l’esprit libre.</em></h2><p>Une autre question ?<br /><a href="mailto:backyardhautdoubs@gmail.com">Écrivez à l’organisation <span aria-hidden="true">↗</span></a></p></div>
          <div class="faq-list">
            <details><summary>Comment s’inscrire ?<span aria-hidden="true">+</span></summary><p>Les inscriptions ouvrent le 6 décembre. <a href="https://inscription.pointcourse.com/epreuve/backyard-du-haut-doubs" target="_blank" rel="noreferrer">Consultez la page d’inscription PointCourse</a> pour les informations et l’ouverture des inscriptions.</p></details>
            <details><summary>Faut-il courir pendant 24 heures ?<span aria-hidden="true">+</span></summary><p>Non, il n’y a pas de distance minimale à viser ni de durée fixée à l’avance. Vous repartez tant que vous terminez chaque boucle en moins d’une heure et êtes présent au départ suivant. Votre objectif vous appartient.</p></details>
            <details><summary>Comment se passent les pauses ?<span aria-hidden="true">+</span></summary><p>Le temps restant avant l’heure suivante est votre temps de récupération. Vous pouvez vous ravitailler et bénéficier de votre assistance dans la zone prévue, puis rejoindre le sas de départ avant le nouveau départ.</p></details>
            <details><summary>Quand le parcours sera-t-il disponible ?<span aria-hidden="true">+</span></summary><p>Le tracé sera communiqué avant l’épreuve. La boucle annoncée mesure 6,706 km avec 240 mètres de dénivelé positif, au départ du Gymnase de Gilley.</p></details>
            <details><summary>Comment rejoindre l’équipe bénévole ?<span aria-hidden="true">+</span></summary><p>Contactez-nous à <a href="mailto:backyardhautdoubs@gmail.com?subject=Devenir%20b%C3%A9n%C3%A9vole">backyardhautdoubs@gmail.com</a> en indiquant vos disponibilités. L’aventure se construit aussi de l’autre côté du ravitaillement !</p></details>
          </div>
        </div>
      </section>

      <section class="partners" id="sponsors" aria-labelledby="sponsors-title">
        <div class="container partners-layout">
          <div>
            <p class="eyebrow"><span></span> Merci pour leur soutien</p>
            <h2 id="sponsors-title">Nos sponsors</h2>
            <p>Ils soutiennent l’aventure de la Backyard du Haut-Doubs à Gilley.</p>
          </div>
          <div class="partners-grid">
            <div class="partner"><span>Anthony Dare</span></div>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="container final-cta-layout">
          <div>
            <p class="eyebrow eyebrow-light"><span></span> L’aventure se construit ensemble</p>
            <h2>Vivez la course<br /><em>de l’intérieur.</em></h2>
          </div>
          <a class="round-link" href="mailto:backyardhautdoubs@gmail.com?subject=Devenir%20b%C3%A9n%C3%A9vole%20%E2%80%94%20Backyard%20du%20Haut-Doubs">
            <span>Devenir<br />bénévole</span>
            <b aria-hidden="true">↗</b>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-grid">
        <a class="footer-brand" href="#accueil">
          <img src="/images/logo-backyard-clair.png" alt="Backyard du Haut-Doubs" width="412" height="270" loading="lazy" />
        </a>
        <p>Une boucle de 6,706 km.<br />Chaque heure. Jusqu’au dernier.</p>
        <div>
          <a href="mailto:backyardhautdoubs@gmail.com">Nous contacter</a>
          <button type="button" disabled={!rulesAvailable} data-open-rules={rulesAvailable ? '' : undefined}>{rulesAvailable ? 'Règlement' : 'Règlement · Prochainement disponible'}</button>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2027 Backyard du Haut-Doubs</span>
        <span>Gilley · France</span>
      </div>
    </footer>

    <dialog class="rules-dialog live-dialog" id="liveDialog" aria-labelledby="live-title">
      <div class="live-dialog-inner">
        <button class="dialog-close" type="button" data-close-live aria-label="Fermer la fenêtre de suivi">×</button>
        <p class="live-kicker"><span></span><b id="waitKicker">Suivi de la course</b></p>
        <h2 id="live-title">À chaque tour,<br /><em>on sera là.</em></h2>
        <p class="live-message">Le suivi en direct n’est pas encore disponible. Rendez-vous ici pour les informations de suivi de la première édition, le 18 septembre 2027.</p>
        <button class="button button-accent live-dialog-action" type="button" data-close-live>Retour au site</button>
      </div>
    </dialog>

    {rulesAvailable && <dialog class="rules-dialog" id="rulesDialog" aria-labelledby="rules-title">
      <div class="dialog-top">
        <div>
          <p class="eyebrow"><span></span> Avant de partir</p>
          <h2 id="rules-title">Règlement officiel</h2>
          <p>Backyard du Haut-Doubs · 18 septembre 2027</p>
        </div>
        <button class="dialog-close" type="button" data-close-rules aria-label="Fermer le règlement">×</button>
      </div>
      <div class="rules-list">
        {rules.map((rule, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{rule.title}</h3><p>{rule.text}</p></div>
          </article>
        ))}
      </div>
      <button class="button button-dark dialog-action" type="button" data-close-rules>J’ai compris</button>
    </dialog>}

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
